{
  "name": "@dsh-ocean/builtin-locales",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Built-in DSH Ocean UI dictionaries; application-owned composition only",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.0-rc.2",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2"
  }
}
